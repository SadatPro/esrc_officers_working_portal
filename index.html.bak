<!DOCTYPE html>
<html lang="en" class="antialiased">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>ESRC DIU · Officers Working Portal</title>

  <!-- Google Font: Roboto Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Supabase JS v2 UMD Client -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            mono: ['"Roboto Mono"', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'monospace'],
            sans: ['"Roboto Mono"', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'monospace']
          },
          boxShadow: {
            'hig-sm': '0 1px 2px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.04)',
            'hig-md': '0 8px 24px -4px rgba(15, 23, 42, 0.08), 0 2px 8px -2px rgba(15, 23, 42, 0.04)',
            'hig-lg': '0 20px 44px -10px rgba(15, 23, 42, 0.16), 0 4px 14px -4px rgba(15, 23, 42, 0.08)'
          }
        }
      }
    };
  </script>

  <style>
    html, body {
      font-family: 'Roboto Mono', monospace;
      font-variant-numeric: tabular-nums;
      overflow-x: hidden;
    }

    /* Ambient HIG Mesh Backdrop */
    .hig-bg {
      background-color: #f4f6fa;
      background-image:
        radial-gradient(at 10% 12%, rgba(37, 99, 235, 0.08) 0px, transparent 50%),
        radial-gradient(at 90% 10%, rgba(16, 185, 129, 0.07) 0px, transparent 45%),
        radial-gradient(at 50% 92%, rgba(99, 102, 241, 0.06) 0px, transparent 55%);
    }
    .dark .hig-bg {
      background-color: #0b0e14;
      background-image:
        radial-gradient(at 10% 12%, rgba(59, 130, 246, 0.13) 0px, transparent 50%),
        radial-gradient(at 90% 10%, rgba(16, 185, 129, 0.09) 0px, transparent 45%),
        radial-gradient(at 50% 92%, rgba(99, 102, 241, 0.10) 0px, transparent 55%);
    }

    /* Frosted Glass Surface */
    .hig-glass {
      backdrop-filter: blur(18px) saturate(160%);
      -webkit-backdrop-filter: blur(18px) saturate(160%);
    }

    /* Tactile HIG Card Hover & Transitions */
    .hig-card {
      transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .hig-card:hover {
      transform: translateY(-2px);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-6px); }
      40% { transform: translateX(6px); }
      60% { transform: translateX(-4px); }
      80% { transform: translateX(4px); }
    }
    .animate-shake {
      animation: shake 0.34s ease-in-out;
    }

    /* Subtle Scrollbars */
    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(128, 128, 128, 0.28); border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(128, 128, 128, 0.45); }

    /* A4 Official Printable Document Sheet */
    .a4-sheet {
      width: 210mm;
      min-height: 297mm;
      background: #ffffff;
      color: #0f172a;
      padding: 16mm 18mm;
      box-sizing: border-box;
      margin: 0 auto;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    @media screen and (max-width: 840px) {
      .a4-sheet {
        width: 100%;
        min-height: auto;
        padding: 20px;
      }
    }

    @page {
      size: A4 portrait;
      margin: 0;
    }

    @media print {
      html, body {
        background: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      #app, #modal-root, #toast-root {
        display: none !important;
      }
      #print-root {
        display: block !important;
        position: static !important;
      }
      .a4-sheet {
        width: 210mm !important;
        min-height: 297mm !important;
        box-shadow: none !important;
        margin: 0 !important;
        padding: 15mm 17mm !important;
      }
    }
  </style>
</head>

<body class="hig-bg text-slate-900 dark:text-slate-100 min-h-screen selection:bg-blue-500/20">
  <!-- Main Application Root -->
  <div id="app"></div>
  <!-- Modal Overlay Root -->
  <div id="modal-root"></div>
  <!-- Toast Notification Root -->
  <div id="toast-root" class="fixed bottom-20 lg:bottom-6 right-4 sm:right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>
  <!-- Dedicated A4 Print Container -->
  <div id="print-root" class="hidden"></div>

  <script>
    (function () {
      'use strict';

      /* =========================================================================
       * 1. ENCRYPTED CREDENTIALS VAULTS (NO PLAINTEXT PASSWORDS IN SOURCE)
       * ========================================================================= */
      const ADMIN_VAULT = [
        {
          slot: 0,
          id: 'adm_01',
          role: 'admin',
          code: 'PRES-01',
          name: 'Sadat Mahmud',
          title: 'President · ESRC DIU',
          avatar: 'SM',
          accent: 'from-blue-600 to-indigo-600',
          seal: '6c681a293f280a602e3b3e3b29606a',
          active: true,
          last_login_at: null
        },
        {
          slot: 1,
          id: 'adm_02',
          role: 'admin',
          code: 'ADM-02',
          name: 'Operations Admin',
          title: 'Operations Lead · ESRC',
          avatar: 'OA',
          accent: 'from-emerald-600 to-teal-600',
          seal: '6c68383b362f333e60683433373e3b606b',
          active: true,
          last_login_at: null
        },
        {
          slot: 2,
          id: 'adm_03',
          role: 'admin',
          code: 'ADM-03',
          name: 'Research Admin',
          title: 'Research Coordinator · ESRC',
          avatar: 'RA',
          accent: 'from-violet-600 to-purple-600',
          seal: '6c68363b2e28352a60693433373e3b6068',
          active: true,
          last_login_at: null
        }
      ];

      const OFFICER_ROSTER = [
        {
          slot: 0,
          id: 'ESRC-GS-01',
          role: 'officer',
          code: 'G.S',
          name: 'Abir Hasan Mahin',
          title: 'General Secretary (G.S)',
          wing: 'General Secretary (G.S)',
          avatar: 'AM',
          accent: 'from-emerald-500 to-teal-600',
          seal: '6c686a6879091d602833383b606a',
          active: true,
          last_login_at: null
        },
        {
          slot: 1,
          id: 'ESRC-VP-02',
          role: 'officer',
          code: 'V.P',
          name: 'Ayatulla Al Saba Kabbo',
          title: 'Vice President',
          wing: 'Vice President',
          avatar: 'AK',
          accent: 'from-cyan-500 to-blue-600',
          seal: '6c686a68790a0c603538383b31606b',
          active: true,
          last_login_at: null
        },
        {
          slot: 2,
          id: 'ESRC-AGS-03',
          role: 'officer',
          code: 'A.G.S',
          name: 'Al Sami',
          title: 'Assistant General Secretary (A.G.S)',
          wing: 'Assistant General Secretary (A.G.S)',
          avatar: 'AS',
          accent: 'from-teal-500 to-emerald-600',
          seal: '6c6879091d1b6033373b296068',
          active: true,
          last_login_at: null
        }
      ];

      function sealCredential(slot, user, pass) {
        const raw = `${slot}:${String(user || '').trim().toLowerCase()}:${String(pass || '')}`;
        const rev = raw.split('').reverse().join('');
        let hex = '';
        for (let i = 0; i < rev.length; i++) {
          hex += (rev.charCodeAt(i) ^ 0x5A).toString(16).padStart(2, '0');
        }
        return hex;
      }

      function constantTimeEqual(a, b) {
        if (!a || !b || a.length !== b.length) return false;
        let diff = 0;
        for (let i = 0; i < a.length; i++) {
          diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
        }
        return diff === 0;
      }

      function matchDirectoryUser(list, preferredSlot, userInput, passInput) {
        const candidates = list.filter(u => u && u.active !== false);
        const ordered = [];
        const pref = candidates.find(u => Number(u.slot) === Number(preferredSlot));
        if (pref) ordered.push(pref);
        candidates.forEach(u => {
          if (!pref || u.id !== pref.id) ordered.push(u);
        });
        for (let i = 0; i < ordered.length; i++) {
          const target = ordered[i];
          const computed = sealCredential(target.slot, userInput, passInput);
          if (constantTimeEqual(computed, target.seal)) {
            return target;
          }
        }
        return null;
      }

      /* =========================================================================
       * 2. SUPABASE CONFIGURATION & SQL SETUP
       * ========================================================================= */
      const SUPABASE_CONFIG = {
        URL: 'https://kpyzvkgfwzeaerhwnstj.supabase.co',
        KEY: 'sb_publishable_6awHRH1MwXKPTkz0s4XbMg_9ZGJAfEU',
        TABLE: 'esrc_records',
        USERS_TABLE: 'esrc_users'
      };

      const SUPABASE_SETUP_SQL = `-- 1. Portal Records Table (Notices, Orders, Applications, Resources)
create table if not exists public.esrc_records (
  id text primary key,
  kind text not null,
  payload jsonb not null,
  created_at bigint not null
);

alter table public.esrc_records enable row level security;

drop policy if exists "ESRC Portal Access" on public.esrc_records;
create policy "ESRC Portal Access"
  on public.esrc_records
  for all
  using (true)
  with check (true);

-- 2. Encrypted Accounts & Login Sync Table (Admin + Officers)
create table if not exists public.esrc_users (
  id text primary key,
  role text not null,
  slot integer not null default 0,
  code text not null,
  name text not null,
  title text not null,
  avatar text not null,
  accent text not null,
  seal text not null,
  active boolean not null default true,
  last_login_at bigint
);

alter table public.esrc_users enable row level security;

drop policy if exists "ESRC Users Access" on public.esrc_users;
create policy "ESRC Users Access"
  on public.esrc_users
  for all
  using (true)
  with check (true);`;

      let sbClient = null;
      try {
        if (window.supabase && typeof window.supabase.createClient === 'function') {
          sbClient = window.supabase.createClient(SUPABASE_CONFIG.URL, SUPABASE_CONFIG.KEY, {
            auth: { persistSession: false, autoRefreshToken: false }
          });
        }
      } catch (err) {
        sbClient = null;
      }

      /* =========================================================================
       * 3. PORTAL CONSTANTS, DEFAULT DATA & STATE
       * ========================================================================= */
      const TOOLS = [
        {
          id: 't1',
          icon: '🎓',
          name: 'Certificate Studio',
          desc: 'Design and batch-generate verified certificates for workshops, seminars, and robotics competitions.',
          url: 'https://sadatpro.github.io/certificate_studio/',
          accent: 'border-t-blue-500'
        },
        {
          id: 't2',
          icon: '📜',
          name: 'Internship Certificate Studio',
          desc: 'Prepare, verify, and issue official ESRC internship completion certificates for outgoing interns.',
          url: 'https://sadatpro.github.io/Internship_Certificate_Studio/',
          accent: 'border-t-emerald-500'
        },
        {
          id: 't3',
          icon: '🗂️',
          name: 'Project Management App',
          desc: 'Plan embedded hardware projects, assign sprints, and monitor team deliverables.',
          url: 'https://sadatpro.github.io/project-management-app/',
          accent: 'border-t-indigo-500'
        }
      ];

      const RESOURCE_CATS = ['Templates', 'Certificates', 'Reports', 'Meetings', 'Projects', 'Other'];
      const APP_TYPES = ['Project Proposal', 'Component Requisition', 'Event & Budget Request', 'Duty & Lab Access'];

      const STORAGE_KEYS = {
        SESSION: 'esrc_hig_session_v5',
        THEME: 'esrc_hig_theme_v5',
        USERS: 'esrc_hig_users_v5',
        NOTICES: 'esrc_hig_notices_v5',
        TASKS: 'esrc_hig_tasks_v5',
        APPLICATIONS: 'esrc_hig_apps_v5',
        RESOURCES: 'esrc_hig_resources_v5'
      };

      const DEFAULT_USERS = [].concat(ADMIN_VAULT, OFFICER_ROSTER);

      const DEFAULT_NOTICES = [
        {
          id: 'ntc_1',
          title: 'Q4 Embedded Robotics Exhibition — Officer Briefing',
          body: 'All executive officers must finalize lab inventory checklists and submit component requisitions through the Applications tab before Friday 17:00.',
          priority: 'High',
          by: 'Sadat Mahmud',
          at: Date.now() - 86400000 * 2
        },
        {
          id: 'ntc_2',
          title: 'A4 Work Order & Approval Protocol Active',
          body: 'Official work orders issued by Admin can be exported directly as A4 sheets. Officers should submit completion links for Admin sign-off.',
          priority: 'Normal',
          by: 'Sadat Mahmud',
          at: Date.now() - 86400000 * 5
        }
      ];

      const DEFAULT_TASKS = [
        {
          id: 'tsk_1',
          orderNo: 'ESRC/WO/2026/001',
          title: 'Prepare STM32 Workshop Kits & Lab Stations',
          desc: 'Inspect 20 STM32F4 Nucleo boards, verify ST-Link cables, and organize oscilloscope probes across Lab Bench 1–5.',
          deliverables: [
            'Test all 20 STM32F4 boards with blink firmware',
            'Label USB-C and ST-Link debugger cables',
            'Upload signed inventory sheet to Google Drive'
          ],
          to: 'Abir Hasan Mahin',
          toId: 'G.S',
          wing: 'General Secretary (G.S)',
          by: 'Sadat Mahmud',
          due: '2026-12-05',
          priority: 'High',
          status: 'open', // open | submitted | revision | approved
          report: '',
          doc: '',
          adminRemarks: '',
          submittedAt: null,
          approvedBy: '',
          approvedAt: null,
          at: Date.now() - 86400000 * 3
        },
        {
          id: 'tsk_2',
          orderNo: 'ESRC/WO/2026/002',
          title: 'Finalize Fall Intern Certificate Roster',
          desc: 'Cross-check attendance logs for all 14 research interns and generate draft PDFs using Internship Certificate Studio.',
          deliverables: [
            'Verify spelling and DIU Student IDs',
            'Generate draft PDFs and upload folder link'
          ],
          to: 'Ayatulla Al Saba Kabbo',
          toId: 'V.P',
          wing: 'Vice President',
          by: 'Sadat Mahmud',
          due: '2026-11-28',
          priority: 'Normal',
          status: 'submitted',
          report: 'All 14 intern records verified against attendance logs. Draft certificates exported to Drive for President review.',
          doc: 'https://drive.google.com/drive/folders/esrc-intern-certs-2026',
          adminRemarks: '',
          submittedAt: Date.now() - 3600000 * 6,
          approvedBy: '',
          approvedAt: null,
          at: Date.now() - 86400000 * 6
        }
      ];

      const DEFAULT_APPLICATIONS = [
        {
          id: 'app_1',
          refNo: 'ESRC/APP/2026/001',
          type: 'Component Requisition',
          title: 'LoRaWAN Telemetry Sensor Modules for Smart Campus Node',
          applicant: 'Al Sami',
          applicantId: 'A.G.S',
          wing: 'Assistant General Secretary (A.G.S)',
          budget: '8,500 BDT',
          targetDate: '2026-12-10',
          summary: 'Requesting approval to procure 4x SX1278 LoRa transceivers, 4x ESP32-S3 devkits, and weatherproof IP65 enclosures for the DIU Smart Campus Air Quality Node.',
          items: [
            '4x SX1278 433MHz LoRa Modules — 2,800 BDT',
            '4x ESP32-S3 DevKitC — 3,600 BDT',
            '4x IP65 Junction Enclosures & LiPo packs — 2,100 BDT'
          ],
          doc: 'https://docs.google.com/spreadsheets/d/esrc-bom-lorawan',
          status: 'pending', // pending | approved | rejected
          adminRemarks: '',
          reviewedBy: '',
          reviewedAt: null,
          at: Date.now() - 86400000 * 1
        },
        {
          id: 'app_2',
          refNo: 'ESRC/APP/2026/002',
          type: 'Project Proposal',
          title: 'Autonomous Line-Maze & PID Controller Bootcamp',
          applicant: 'Abir Hasan Mahin',
          applicantId: 'G.S',
          wing: 'General Secretary (G.S)',
          budget: '5,000 BDT',
          targetDate: '2026-12-18',
          summary: 'A 2-day hands-on workshop for 40 junior DIU students covering IR sensor arrays, PID tuning, and PCB soldering in the ESRC Hardware Lab.',
          items: [
            'Lab reservation for Friday–Saturday (10:00–16:00)',
            'Printed workshop handouts & participant certificates',
            'Refreshment allocation for 40 attendees'
          ],
          doc: 'https://docs.google.com/document/d/esrc-pid-bootcamp',
          status: 'approved',
          adminRemarks: 'Approved. Coordinate venue keys with Operations Admin 48 hours prior.',
          reviewedBy: 'Sadat Mahmud',
          reviewedAt: Date.now() - 43200000,
          at: Date.now() - 86400000 * 4
        }
      ];

      const DEFAULT_RESOURCES = [
        {
          id: 'res_1',
          title: 'ESRC Official Letterhead & A4 Templates',
          url: 'https://drive.google.com/drive/folders/esrc-official-templates',
          desc: 'Approved DIU ESRC logos, letterhead templates, and slide decks.',
          cat: 'Templates',
          by: 'Sadat Mahmud',
          at: Date.now() - 86400000 * 7
        },
        {
          id: 'res_2',
          title: 'Lab Inventory Master Sheet 2026',
          url: 'https://docs.google.com/spreadsheets/d/esrc-lab-inventory-2026',
          desc: 'Live microcontroller, sensor, and equipment checkout ledger.',
          cat: 'Projects',
          by: 'Abir Hasan Mahin',
          at: Date.now() - 86400000 * 4
        }
      ];

      function loadJSON(key, fallback) {
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return JSON.parse(JSON.stringify(fallback));
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : JSON.parse(JSON.stringify(fallback));
        } catch (e) {
          return JSON.parse(JSON.stringify(fallback));
        }
      }

      function saveJSON(key, value) {
        try {
          localStorage.setItem(key, JSON.stringify(value));
        } catch (e) {}
      }

      const state = {
        user: null,
        loginSegment: 'admin',
        loginSlot: 0,
        officerSlot: 0,
        failedAttempts: 0,
        lockUntil: 0,
        view: 'home',
        mobileMenu: false,
        cat: 'All',
        query: '',
        taskQuery: '',
        appQuery: '',
        taskFilter: 'all',
        appFilter: 'all',
        appTypeFilter: 'All',
        cloudStatus: sbClient ? 'connecting' : 'offline',
        authCloudStatus: sbClient ? 'connecting' : 'offline',
        lastSyncAt: null,
        users: loadJSON(STORAGE_KEYS.USERS, DEFAULT_USERS),
        notices: loadJSON(STORAGE_KEYS.NOTICES, DEFAULT_NOTICES),
        tasks: loadJSON(STORAGE_KEYS.TASKS, DEFAULT_TASKS),
        applications: loadJSON(STORAGE_KEYS.APPLICATIONS, DEFAULT_APPLICATIONS),
        resources: loadJSON(STORAGE_KEYS.RESOURCES, DEFAULT_RESOURCES)
      };

      const KIND_TO_STORAGE = {
        notices: STORAGE_KEYS.NOTICES,
        tasks: STORAGE_KEYS.TASKS,
        applications: STORAGE_KEYS.APPLICATIONS,
        resources: STORAGE_KEYS.RESOURCES
      };

      function getAdminDirectory() {
        return state.users.filter(u => u.role === 'admin').sort((a, b) => Number(a.slot) - Number(b.slot));
      }

      function getOfficerDirectory() {
        return state.users.filter(u => u.role === 'officer').sort((a, b) => Number(a.slot) - Number(b.slot));
      }

      function isAdmin() {
        return !!(state.user && state.user.role === 'admin');
      }

      /* =========================================================================
       * 4. SUPABASE CLOUD & AUTH DIRECTORY SYNC (HTTPS-ONLY, NO WEBSOCKETS)
       * ========================================================================= */
      async function syncUsersFromSupabase(silent = true) {
        if (!sbClient) {
          state.authCloudStatus = 'offline';
          return state.users;
        }
        try {
          const res = await sbClient
            .from(SUPABASE_CONFIG.USERS_TABLE)
            .select('*')
            .order('slot', { ascending: true });

          if (res.error) {
            if (res.error.code === '42P01' || res.error.code === 'PGRST205' || /esrc_users/i.test(res.error.message || '')) {
              state.authCloudStatus = 'setup-needed';
            } else {
              state.authCloudStatus = 'offline';
            }
            if (!silent) showToast('Run SQL setup to activate Supabase Login table', 'error');
            return state.users;
          }

          const data = res.data || [];
          if (data.length === 0) {
            const seedUsers = DEFAULT_USERS.map(u => ({
              id: u.id,
              role: u.role,
              slot: Number(u.slot || 0),
              code: u.code,
              name: u.name,
              title: u.title || u.wing || 'ESRC Member',
              avatar: u.avatar,
              accent: u.accent,
              seal: u.seal,
              active: u.active !== false,
              last_login_at: u.last_login_at || null
            }));
            await sbClient.from(SUPABASE_CONFIG.USERS_TABLE).upsert(seedUsers);
            state.users = seedUsers.map(u => Object.assign({}, u, { wing: u.title }));
          } else {
            state.users = data.map(u => Object.assign({}, u, { wing: u.title }));
          }

          saveJSON(STORAGE_KEYS.USERS, state.users);
          state.authCloudStatus = 'synced';
          return state.users;
        } catch (e) {
          state.authCloudStatus = 'offline';
          return state.users;
        }
      }

      async function upsertUserToSupabase(userObj) {
        const clean = {
          id: userObj.id,
          role: userObj.role,
          slot: Number(userObj.slot || 0),
          code: userObj.code,
          name: userObj.name,
          title: userObj.title || userObj.wing || 'ESRC Member',
          avatar: userObj.avatar,
          accent: userObj.accent || 'from-emerald-500 to-teal-600',
          seal: userObj.seal,
          active: userObj.active !== false,
          last_login_at: userObj.last_login_at || null
        };
        const idx = state.users.findIndex(u => u.id === clean.id);
        if (idx >= 0) state.users[idx] = Object.assign({}, clean, { wing: clean.title });
        else state.users.push(Object.assign({}, clean, { wing: clean.title }));
        saveJSON(STORAGE_KEYS.USERS, state.users);

        if (!sbClient || state.authCloudStatus === 'setup-needed') return false;
        try {
          const res = await sbClient.from(SUPABASE_CONFIG.USERS_TABLE).upsert(clean);
          if (!res.error) {
            state.authCloudStatus = 'synced';
            return true;
          }
        } catch (e) {}
        return false;
      }

      async function authenticateWithSupabase(role, preferredSlot, userInput, passInput) {
        await syncUsersFromSupabase(true);
        const list = role === 'admin' ? getAdminDirectory() : getOfficerDirectory();
        const matched = matchDirectoryUser(list, preferredSlot, userInput, passInput);
        if (!matched) return null;

        matched.last_login_at = Date.now();
        await upsertUserToSupabase(matched);
        return matched;
      }

      async function pushRecordToSupabase(kind, item) {
        saveJSON(KIND_TO_STORAGE[kind], state[kind]);
        if (!sbClient || state.cloudStatus === 'setup-needed') return;
        try {
          const res = await sbClient.from(SUPABASE_CONFIG.TABLE).upsert({
            id: item.id,
            kind: kind,
            payload: item,
            created_at: item.at || Date.now()
          });
          if (!res.error) {
            state.cloudStatus = 'synced';
            state.lastSyncAt = Date.now();
          }
        } catch (e) {}
      }

      async function deleteRecordFromSupabase(kind, id) {
        state[kind] = state[kind].filter(x => x.id !== id);
        saveJSON(KIND_TO_STORAGE[kind], state[kind]);
        if (!sbClient || state.cloudStatus === 'setup-needed') return;
        try {
          await sbClient.from(SUPABASE_CONFIG.TABLE).delete().eq('id', id);
        } catch (e) {}
      }

      async function syncPullFromSupabase(silent = false) {
        await syncUsersFromSupabase(true);
        if (!sbClient) {
          state.cloudStatus = 'offline';
          if (state.user) renderApp();
          else renderLogin();
          return;
        }
        try {
          const res = await sbClient
            .from(SUPABASE_CONFIG.TABLE)
            .select('*')
            .order('created_at', { ascending: false });

          if (res.error) {
            if (res.error.code === '42P01' || res.error.code === 'PGRST205' || /esrc_records/i.test(res.error.message || '')) {
              state.cloudStatus = 'setup-needed';
              if (!silent) showToast('Supabase table not found — click SETUP DB SQL', 'error');
            } else {
              state.cloudStatus = 'offline';
              if (!silent) showToast('Supabase sync unavailable (using local cache)', 'error');
            }
            if (state.user) renderApp();
            else renderLogin();
            return;
          }

          const rows = res.data || [];
          if (rows.length === 0) {
            // Seed initial records into empty cloud table
            const seedRows = [];
            ['notices', 'tasks', 'applications', 'resources'].forEach(kind => {
              state[kind].forEach(item => {
                seedRows.push({
                  id: item.id,
                  kind: kind,
                  payload: item,
                  created_at: item.at || Date.now()
                });
              });
            });
            if (seedRows.length) {
              await sbClient.from(SUPABASE_CONFIG.TABLE).upsert(seedRows);
            }
          } else {
            const grouped = { notices: [], tasks: [], applications: [], resources: [] };
            rows.forEach(r => {
              if (grouped[r.kind] && r.payload) {
                grouped[r.kind].push(r.payload);
              }
            });
            ['notices', 'tasks', 'applications', 'resources'].forEach(kind => {
              state[kind] = grouped[kind].sort((a, b) => (b.at || 0) - (a.at || 0));
              saveJSON(KIND_TO_STORAGE[kind], state[kind]);
            });
          }

          state.cloudStatus = 'synced';
          state.lastSyncAt = Date.now();
          if (!silent) showToast('Synced with Supabase cloud', 'success');
          if (state.user) renderApp();
          else renderLogin();
        } catch (err) {
          state.cloudStatus = 'offline';
          if (state.user) renderApp();
          else renderLogin();
        }
      }

      let syncTimer = null;
      function startSupabaseAutoSync() {
        if (syncTimer) clearInterval(syncTimer);
        syncTimer = setInterval(() => {
          if (document.visibilityState === 'visible' && state.user) {
            syncPullFromSupabase(true);
          }
        }, 20000);
        window.addEventListener('focus', () => {
          if (state.user) syncPullFromSupabase(true);
        });
      }

      /* =========================================================================
       * 5. THEME, UTILITIES, TOASTS & MODAL ENGINE
       * ========================================================================= */
      function initTheme() {
        const saved = localStorage.getItem(STORAGE_KEYS.THEME);
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = saved ? saved === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      }

      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem(STORAGE_KEYS.THEME, isDark ? 'dark' : 'light'); } catch (e) {}
      }

      function escapeHtml(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function normalizeUrl(u) {
        let s = String(u || '').trim();
        if (!s) return null;
        if (!/^[a-z]+:\/\//i.test(s)) s = 'https://' + s;
        try {
          const parsed = new URL(s);
          return /^https?:$/.test(parsed.protocol) ? parsed.href : null;
        } catch (e) {
          return null;
        }
      }

      function detectLinkKind(u) {
        try {
          const x = new URL(u);
          const p = x.pathname;
          if (/docs\.google\.com/i.test(x.host)) {
            if (/\/spreadsheets/i.test(p)) return ['📊', 'Google Sheet'];
            if (/\/presentation/i.test(p)) return ['📽️', 'Google Slides'];
            if (/\/forms/i.test(p)) return ['📝', 'Google Form'];
            return ['📄', 'Google Doc'];
          }
          if (/drive\.google\.com/i.test(x.host)) {
            return /folders/i.test(p) ? ['📁', 'Drive Folder'] : ['📎', 'Drive File'];
          }
        } catch (e) {}
        return ['🔗', 'Web Link'];
      }

      function formatDate(ts) {
        if (!ts) return '—';
        try {
          return new Date(ts).toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });
        } catch (e) {
          return '—';
        }
      }

      function formatRelativeTime(ts) {
        if (!ts) return 'Never signed in';
        const diff = Math.max(0, Date.now() - ts);
        const mins = Math.floor(diff / 60000);
        if (mins < 1) return 'Active just now';
        if (mins < 60) return `Active ${mins}m ago`;
        const hrs = Math.floor(mins / 60);
        if (hrs < 24) return `Active ${hrs}h ago`;
        return `Last seen ${formatDate(ts)}`;
      }

      function copyToClipboard(text) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          showToast('Copied to clipboard', 'success');
        } catch (e) {
          showToast('Could not copy automatically', 'error');
        }
      }

      function showToast(message, type = 'info') {
        const root = document.getElementById('toast-root');
        if (!root) return;
        const colors = {
          success: 'border-emerald-500/30 bg-emerald-500/15 text-emerald-800 dark:text-emerald-200',
          error: 'border-red-500/30 bg-red-500/15 text-red-800 dark:text-red-200',
          info: 'border-blue-500/30 bg-blue-500/15 text-blue-800 dark:text-blue-200'
        };
        const el = document.createElement('div');
        el.className = `pointer-events-auto hig-glass px-4 py-2.5 rounded-2xl border shadow-hig-md text-xs font-semibold animate-fade-in ${colors[type] || colors.info}`;
        el.textContent = message;
        root.appendChild(el);
        setTimeout(() => {
          el.style.opacity = '0';
          el.style.transition = 'opacity 0.25s ease';
          setTimeout(() => el.remove(), 260);
        }, 2800);
      }

      function openModal(title, subtitle, bodyHtml, onMount, maxWidthClass = 'max-w-lg') {
        const root = document.getElementById('modal-root');
        if (!root) return;
        root.innerHTML = `
          <div id="modal-backdrop" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 overflow-y-auto">
            <div class="w-full ${maxWidthClass} hig-glass bg-white/95 dark:bg-[#151922]/95 border border-black/10 dark:border-white/10 rounded-3xl shadow-hig-lg p-5 sm:p-6 my-auto animate-fade-in max-h-[92vh] overflow-y-auto">
              <div class="flex items-start justify-between gap-3 mb-4 pb-3 border-b border-black/[0.06] dark:border-white/[0.07]">
                <div>
                  <h3 class="text-sm font-bold text-slate-900 dark:text-white">${escapeHtml(title)}</h3>
                  ${subtitle ? `<p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">${escapeHtml(subtitle)}</p>` : ''}
                </div>
                <button type="button" id="modal-x" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-800 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition" aria-label="Close">✕</button>
              </div>
              <div>${bodyHtml}</div>
            </div>
          </div>
        `;
        document.getElementById('modal-x').onclick = closeModal;
        document.getElementById('modal-backdrop').onclick = (e) => {
          if (e.target.id === 'modal-backdrop') closeModal();
        };
        if (typeof onMount === 'function') onMount();
      }

      function closeModal() {
        const root = document.getElementById('modal-root');
        if (root) root.innerHTML = '';
      }

      function openConfirmModal(title, message, onConfirm) {
        openModal(title, '', `
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-5">${escapeHtml(message)}</p>
          <div class="flex justify-end gap-2">
            <button type="button" id="cfm-cancel" class="px-4 py-2 rounded-xl text-xs font-medium border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5">Cancel</button>
            <button type="button" id="cfm-ok" class="px-4 py-2 rounded-xl text-xs font-semibold bg-red-600 hover:bg-red-700 text-white">Remove</button>
          </div>
        `, () => {
          document.getElementById('cfm-cancel').onclick = closeModal;
          document.getElementById('cfm-ok').onclick = () => {
            closeModal();
            onConfirm();
          };
        }, 'max-w-sm');
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const root = document.getElementById('modal-root');
          if (root && root.innerHTML.trim()) {
            closeModal();
          } else if (state.mobileMenu) {
            state.mobileMenu = false;
            renderApp();
          }
        }
      });

      /* =========================================================================
       * 6. SVG LOGOS & ICONS
       * ========================================================================= */
      function esrcLogoSvg(cls = 'w-10 h-10') {
        return `
          <svg class="${cls}" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="esrcG" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
                <stop stop-color="#1D4ED8"/>
                <stop offset="1" stop-color="#10B981"/>
              </linearGradient>
            </defs>
            <rect width="64" height="64" rx="16" fill="url(#esrcG)"/>
            <rect x="17" y="17" width="30" height="30" rx="6" stroke="white" stroke-width="2.6" fill="rgba(255,255,255,0.12)"/>
            <path d="M25 27H39M25 32H35M25 37H39" stroke="white" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M24 11V17M32 11V17M40 11V17M24 47V53M32 47V53M40 47V53M11 24H17M11 32H17M11 40H17M47 24H53M47 32H53M47 40H53" stroke="white" stroke-opacity="0.85" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        `;
      }

      const ICONS = {
